---
import View from '../../../views/Case.astro';
import { coll, slugOf } from '../../../lib/i18n';
export async function getStaticPaths() {
  return (await coll('en', 'cases', (c) => c.data.published)).map((e) => ({ params: { slug: slugOf(e) }, props: { e } }));
}
---
<View lang="en" entry={Astro.props.e} />
