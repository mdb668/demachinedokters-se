---
import Base from '../layouts/Base.astro';
import Swoosh from '../components/Swoosh.astro';
import Quote from '../components/Quote.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Benefits from '../components/Benefits.astro';
import Plan from '../components/Plan.astro';
import ContactCard from '../components/ContactCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { renderText } from '../lib/md';
import { pageOf, coll, byOrder, regionPath, routes, nlUrl, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = await pageOf(lang, 'home');
const regions = (await coll(lang, 'regions')).sort(byOrder);
---
<Base lang={lang} transparentHeader alt={routes.home} nl={nlUrl('home')}>
  <section class="hero">
    {p.hero.video && (
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={p.hero.poster} aria-hidden="true"
        data-src-desktop={p.hero.video} data-src-mobile={p.hero.videoMobile ?? p.hero.video}>
      </video>
    )}
    <img class="hero-fallback" src={p.hero.poster} alt="" aria-hidden="true" />
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1>{p.hero.kicker && <span class="kicker">{p.hero.kicker}</span>}{' '}{p.hero.title}</h1>
      <p class="tagline">{p.hero.subtitle}</p>
      {p.hero.lead && <p class="hero-lead">{p.hero.lead}</p>}
    </div>
    <Swoosh variant="bottom" fill="#ffffff" />
  </section>

  <section class="section-sm intro">
    <div class="container intro-grid">
      <div class="intro-text center">
        <p class="lead"><strong>{p.intro.line1}</strong></p>
        <p class="muted">{p.intro.line2}</p>
        <div class="btn-group">
          <a class="btn btn-primary" href={p.intro.button1Link}>{p.intro.button1Label}</a>
          <a class="btn btn-outline" href={p.intro.button2Link}>{p.intro.button2Label}</a>
        </div>
      </div>
      <div class="intro-quote"><Quote text={p.intro.quote} /></div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container"><ServiceCards lang={lang} /></div>
  </section>

  <section class="section verschil">
    <div class="container">
      <h2 class="center"><span class="title-underline">{p.difference.title}</span></h2>
      <div class="grid grid-3 verschil-grid">
        {p.difference.items.map((it: any) => (
          <div>
            <h3>{it.title}</h3>
            <div class="muted" set:html={renderText(it.text)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-bg klachten">
    <div class="container">
      <div class="klachten-head">
        <div class="kq"><Quote text={p.symptoms.quote} /></div>
        <div class="center">
          <h2>{p.symptoms.title}</h2>
          <p class="muted intro-k">{p.symptoms.intro}</p>
        </div>
      </div>
      <div class="klachten-list">
        {p.symptoms.items.map((it: any, i: number) => (
          <article class={`klacht card ${i % 2 ? 'right' : ''}`}>
            <img src={it.image} alt={it.imageAlt ?? ''} loading="lazy" width="800" height="600" />
            <div>
              <h3>{it.title}</h3>
              <div class="muted" set:html={renderText(it.text)} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Benefits lang={lang} button1Label={p.symptoms.button1Label} button1Link={p.symptoms.button1Link} button2Label={p.symptoms.button2Label} button2Link={p.symptoms.button2Link} />
  <Plan lang={lang} />

  <section class="section-sm section-bg">
    <div class="container center">
      <h2><span class="title-underline">{p.regions.title}</span></h2>
      <p class="muted intro-k">{p.regions.intro}</p>
      <div class="grid grid-3 region-grid">
        {regions.map((r) => (
          <a class="card region" href={regionPath(lang, r)}>
            <span class="icon-circle"><Icon name="pin" size={28} /></span>
            <h3>{r.data.name}</h3>
            {r.data.places && <p class="muted">{r.data.places}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section over">
    <div class="container over-grid">
      <div>
        <h2>{p.about.title}</h2>
        <div class="muted" set:html={renderText(p.about.text)} />
        <a class="more" href={p.about.link}>{p.about.linkLabel}</a>
      </div>
      <div><ContactCard lang={lang} /></div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<script>
  // Kies de juiste videokwaliteit (mobiel/desktop), start afspelen en toon anders de poster.
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData === true;
    if (!reduce && !saveData) {
      const src = window.innerWidth < 768 ? video.dataset.srcMobile : video.dataset.srcDesktop;
      if (src) {
        video.src = src;
        video.load();
        const tryPlay = () => video.play().then(() => video.classList.add('is-playing')).catch(() => {});
        video.addEventListener('canplay', tryPlay, { once: true });
        video.addEventListener('playing', () => video.classList.add('is-playing'));
        tryPlay();
        document.addEventListener('visibilitychange', () => { if (!document.hidden && video.paused) tryPlay(); });
        window.addEventListener('pageshow', tryPlay);
      }
    }
  }
</script>

<style>
  .hero { position: relative; min-height: min(92vh, 780px); display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; background: var(--blue); }
  .hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.8s ease; z-index: 1; }
  .hero-video.is-playing { opacity: 1; }
  .hero-overlay { position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, rgba(7, 76, 130, 0.45), rgba(7, 76, 130, 0.65)); }
  .hero-content { position: relative; z-index: 3; padding: 140px 0 160px; }
  .hero h1 { color: #fff; font-size: clamp(2.6rem, 6vw, 4.4rem); margin-bottom: 0.2em; text-shadow: 0 2px 20px rgba(0, 0, 0, 0.25); }
  .hero h1 .kicker { display: block; font-size: clamp(0.8rem, 1.3vw, 1rem); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sky); text-shadow: none; margin-bottom: 0.6em; }
  .hero-lead { color: rgba(255, 255, 255, 0.92); font-size: clamp(1rem, 1.4vw, 1.15rem); max-width: 720px; margin: 18px auto 0; }
  .tagline { color: #fff; font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 500; margin: 0; letter-spacing: 0.02em; }
  .intro-grid { display: grid; grid-template-columns: 1fr 280px; gap: 24px; align-items: center; }
  .intro-text { max-width: 720px; margin-inline: auto; }
  .intro-quote { text-align: center; }
  @media (max-width: 860px) { .intro-grid { grid-template-columns: 1fr; } }
  .verschil-grid { margin-top: 40px; }
  .verschil h3 { font-size: 1.2rem; }
  .klachten-head { display: grid; grid-template-columns: 240px 1fr 240px; align-items: center; gap: 16px; }
  .klachten-head > .center { grid-column: 2; }
  .kq { grid-column: 1; text-align: center; }
  .intro-k { max-width: 820px; margin-inline: auto; }
  .klachten-list { display: grid; gap: 28px; margin-top: 40px; }
  .klacht { display: grid; grid-template-columns: 320px 1fr; gap: 28px; align-items: center; padding: 18px; max-width: 900px; }
  .klacht.right { margin-left: auto; }
  .klacht img { width: 100%; height: 220px; object-fit: cover; border-radius: 10px; }
  .klacht h3 { font-size: 1.3rem; }
  .klacht :global(p:last-child) { margin-bottom: 0; }
  @media (max-width: 900px) { .klachten-head { grid-template-columns: 1fr; } .kq { display: none; } .klachten-head > .center { grid-column: 1; } }
  @media (max-width: 700px) { .klacht { grid-template-columns: 1fr; } }
  .region-grid { margin-top: 32px; }
  .region { display: block; color: inherit; text-decoration: none !important; }
  .region h3 { margin: 14px 0 6px; font-size: 1.25rem; }
  .region p { margin: 0; font-size: 0.95rem; }
  .over-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
  .more { font-weight: 500; display: inline-block; margin-bottom: 20px; }
  @media (max-width: 860px) { .over-grid { grid-template-columns: 1fr; } }
</style>
