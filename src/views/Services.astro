---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Benefits from '../components/Benefits.astro';
import CtaBand from '../components/CtaBand.astro';
import { render } from 'astro:content';
import { pageOf, uiOf, coll, byOrder, servicePath, slugOf, routes, nlUrl, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = await pageOf(lang, 'services');
const ui = await uiOf(lang);
const services = (await coll(lang, 'services')).sort(byOrder);
const rendered = await Promise.all(services.map(async (s) => ({ ...s, Content: (await render(s)).Content })));
---
<Base lang={lang} title={p.seoTitle} description={p.seoDescription} alt={routes.services} nl={nlUrl('services')}>
  <PageHero title={p.title} subtitle={p.subtitle} intro={p.intro} quote={p.quote} />
  <section class="section-sm">
    <div class="container"><ServiceCards lang={lang} /></div>
  </section>
  <section class="section-sm">
    <div class="container detail-list">
      {rendered.map((s, i) => (
        <article id={slugOf(s)} class={`detail ${i % 2 ? 'flip' : ''}`}>
          <div class="text">
            <h2>{s.data.title}</h2>
            <p class="tag">{s.data.tagline}</p>
            <p class="muted">{s.data.short}</p>
            <a class="btn btn-outline btn-sm" href={servicePath(lang, s)}>{ui.moreAbout} {s.data.title.toLowerCase()}</a>
          </div>
          {s.data.image && <img src={s.data.image} alt={s.data.imageAlt ?? s.data.title} loading="lazy" width="700" height="480" class="rounded shadow" />}
        </article>
      ))}
    </div>
  </section>
  <Benefits lang={lang} button1Label={p.button1Label} button1Link={p.button1Link} button2Label={p.button2Label} button2Link={p.button2Link} />
  <section class="section-sm center">
    <div class="container-narrow">
      <h2>{p.whyTitle}</h2>
      <p class="lead muted">{p.whyText}</p>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
<style>
  .detail-list { display: grid; gap: clamp(40px, 6vw, 80px); }
  .detail { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; scroll-margin-top: 110px; }
  .detail.flip .text { order: 2; }
  .detail img { width: 100%; height: 100%; max-height: 360px; object-fit: cover; }
  .tag { font-weight: 500; color: var(--blue); }
  @media (max-width: 860px) { .detail { grid-template-columns: 1fr; } .detail.flip .text { order: 0; } }
</style>
