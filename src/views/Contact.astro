---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactCard from '../components/ContactCard.astro';
import Icon from '../components/Icon.astro';
import Mail from '../components/Mail.astro';
import { siteOf, pageOf, routes, nlUrl, isTodo, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const site = await siteOf(lang);
const p = await pageOf(lang, 'contact');
---
<Base lang={lang} title={p.seoTitle} description={p.seoDescription} alt={routes.contact} nl={nlUrl('contact')}>
  <section class="page-hero">
    <div class="container">
      <h1>{p.title}</h1>
      <p class="intro">{p.intro}</p>
    </div>
  </section>
  <section class="section-sm">
    <div class="container contact-grid">
      <div><ContactForm lang={lang} /></div>
      <aside class="info">
        <ContactCard lang={lang} compact />
        <div class="block"><span class="icon-circle"><Icon name="pin" size={26} /></span><div><h4>{p.labels.address}</h4><p>{site.addressLine1}<br />{site.addressLine2}</p></div></div>
        <div class="block"><span class="icon-circle"><Icon name="phone" size={26} /></span><div><h4>{p.labels.phone}</h4><p>{isTodo(site.phoneLink) ? site.phone : <a href={site.phoneLink}>{site.phone}</a>}</p></div></div>
        <div class="block"><span class="icon-circle"><Icon name="mail" size={26} /></span><div><h4>{p.labels.email}</h4><p><Mail lang={lang} /></p></div></div>
        <div class="block"><span class="icon-circle"><Icon name="clock" size={26} /></span><div><h4>{p.labels.hours}</h4><p>{site.openingHours}</p></div></div>
        {site.serviceArea && <p class="muted area">{site.serviceArea}</p>}
      </aside>
    </div>
  </section>
</Base>
<style>
  .contact-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; }
  .info { display: grid; gap: 22px; }
  .block { display: flex; gap: 16px; align-items: flex-start; }
  .block h4 { margin-bottom: 0.2em; }
  .block p { margin: 0; color: var(--muted); }
  .area { margin: 0; font-size: 0.95rem; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
