---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCard from '../components/ContactCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { pageOf, coll, byOrder, regionPath, routes, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = await pageOf(lang, 'regions');
const regions = (await coll(lang, 'regions')).sort(byOrder);
---
<Base lang={lang} title={p.seoTitle} description={p.seoDescription} alt={routes.regions}>
  <PageHero title={p.title} subtitle={p.subtitle} intro={p.intro} />
  <section class="section-sm">
    <div class="container grid grid-3">
      {regions.map((r) => (
        <a class="card region" href={regionPath(lang, r)}>
          <span class="icon-circle"><Icon name="pin" size={28} /></span>
          <h2>{r.data.name}</h2>
          <p class="muted">{r.data.intro}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="section-sm"><div class="container"><ContactCard lang={lang} /></div></section>
  <CtaBand lang={lang} />
</Base>
<style>
  .region { display: block; color: inherit; text-decoration: none !important; }
  .region h2 { font-size: 1.35rem; margin: 14px 0 8px; }
  .region p { margin: 0; font-size: 0.97rem; }
</style>
