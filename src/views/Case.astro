---
import Base from '../layouts/Base.astro';
import Benefits from '../components/Benefits.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { renderText } from '../lib/md';
import { render } from 'astro:content';
import { uiOf, pageOf, path, abs, casePath, alternatesFor, type Lang } from '../lib/i18n';
interface Props { lang: Lang; entry: any }
const { lang, entry } = Astro.props;
const ui = await uiOf(lang);
const cp = await pageOf(lang, 'cases');
const d = entry.data;
const { Content } = await render(entry);
const here = casePath(lang, entry);
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: ui.home, item: abs(path(lang, 'home')) },
  { '@type': 'ListItem', position: 2, name: cp.title, item: abs(path(lang, 'cases')) },
  { '@type': 'ListItem', position: 3, name: d.title, item: abs(here) },
] };
---
<Base lang={lang} title={d.seoTitle || `${d.title}: ${d.subtitle}`} description={d.seoDescription || d.intro} image={d.image} jsonLd={crumbLd} alt={await alternatesFor('cases', entry, (c) => c.data.published)}>
  <section class="page-hero">
    <div class="container">
      <h1>{d.title}{' '}<span class="sub">{d.subtitle}</span></h1>
      <p class="intro">{d.intro}</p>
      <a class="back" href={path(lang, 'cases')}><Icon name="arrow-left" size={20} /> {cp.backLabel}</a>
    </div>
  </section>
  <section class="section-sm">
    <div class="container center">
      {d.image && <div class={`case-media ${d.imageIsLogo ? 'is-logo' : ''}`}><img src={d.image} alt={d.imageAlt ?? d.title} width="900" height="600" /></div>}
      {d.stats.length > 0 && (
        <div class="stats">
          {d.stats.map((s: any) => (
            <div class="stat">
              <span class="icon-circle lg"><Icon name={s.icon} size={40} stroke={1.3} /></span>
              <strong>{s.value}</strong>
              <span class="muted">{s.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
  <section class="section-sm">
    <div class="container-narrow case-body">
      <h2>{cp.challengeTitle}</h2>
      <div class="muted" set:html={renderText(d.challenge)} />
      <h2>{cp.approachTitle}</h2>
      <div class="muted" set:html={renderText(d.approach)} />
      {d.results.length > 0 && <h2>{cp.resultTitle}</h2>}
      <ul class="results">{d.results.map((r: string) => <li><Icon name="check" size={22} /> {r}</li>)}</ul>
      {d.closing && <p class="closing">{d.closing}</p>}
      <div class="prose"><Content /></div>
    </div>
  </section>
  <Benefits lang={lang} button1Label={cp.button1Label} button1Link={cp.button1Link} button2Label={cp.button2Label} button2Link={cp.button2Link} />
  <CtaBand lang={lang} title={cp.ctaTitle} text={cp.ctaText} />
</Base>
<style>
  .back { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; }
  .case-media { max-width: 900px; margin: 0 auto 32px; border-radius: var(--radius); overflow: hidden; }
  .case-media img { width: 100%; height: auto; }
  .case-media.is-logo { max-width: 360px; }
  .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 40px; }
  .stat { display: grid; justify-items: center; gap: 6px; max-width: 220px; }
  .stat strong { font-size: 1.5rem; color: var(--blue); }
  .case-body h2 { margin-top: 1.4em; }
  .results { list-style: none; padding: 0; display: grid; gap: 8px; }
  .results li { display: flex; gap: 10px; align-items: flex-start; }
  .results :global(svg) { flex: none; color: var(--green); margin-top: 3px; }
  .closing { font-weight: 500; color: var(--blue); margin-top: 1.5em; }
</style>
