---
import Swoosh from './Swoosh.astro';
import Icon from './Icon.astro';
import { siteOf, uiOf, isTodo, type Lang } from '../lib/i18n';
/** Contactblok onderaan de pagina. title/text per pagina; zonder title de algemene tekst uit "Kleine teksten". */
interface Props { lang: Lang; title?: string; text?: string }
const { lang } = Astro.props;
const site = await siteOf(lang);
const ui = await uiOf(lang);
const title = Astro.props.title || ui.ctaTitle;
const text = Astro.props.text || ui.ctaText;
---
<section class="cta-band">
  <Swoosh variant="top" fill="#ffffff" />
  <div class="container center content">
    <h2 class="light">{title}</h2>
    {text && <p class="light-text">{text}</p>}
    <div class="actions">
      <a class="btn btn-primary" href={site.ctaLink}>{site.ctaLabel}</a>
      {!isTodo(site.phoneLink) && <a class="btn btn-ghost" href={site.phoneLink}><Icon name="phone" size={20} /> {ui.callPrefix} {site.phone}</a>}
    </div>
  </div>
</section>
<style>
  .cta-band { position: relative; background: var(--blue); padding: clamp(90px, 12vw, 150px) 0 clamp(40px, 5vw, 60px); margin-top: 40px; }
  .content { position: relative; }
  .light { color: #fff; }
  .light-text { color: rgba(255, 255, 255, 0.85); max-width: 640px; margin: 0 auto 1.5em; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .btn-ghost { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.6); display: inline-flex; align-items: center; gap: 8px; }
  .btn-ghost:hover { background: #fff; color: var(--blue); }
</style>
